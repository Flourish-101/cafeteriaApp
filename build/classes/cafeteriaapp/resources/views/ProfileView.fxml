<?xml version="1.0" encoding="UTF-8"?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="560.0" prefWidth="904.0" spacing="0"
      style="-fx-background-color: #f8f9fa;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cafeteriaapp.resources.controllers.ProfileController">
  <children>
    <!-- Profile header -->
    <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #0d7377;">
      <children>
        <StackPane>
          <children>
            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50;"
                       minWidth="80" minHeight="80" maxWidth="80" maxHeight="80">
              <children>
                <FontAwesomeIconView glyphName="USER" fill="white" size="36" />
              </children>
            </StackPane>
          </children>
        </StackPane>
        <Label fx:id="fullNameLabel" text="User Name" textFill="WHITE"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="emailLabel" text="user@email.com" textFill="rgba(255,255,255,0.65)"
               style="-fx-font-size: 13px;" />
      </children>
      <padding><Insets top="30" bottom="30" /></padding>
    </VBox>

    <!-- Balance card -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);"
          alignment="CENTER" spacing="5">
      <children>
        <Label text="Wallet Balance" style="-fx-font-size: 13px; -fx-text-fill: #888;" />
        <Label fx:id="balanceLabel" text="₦0.00"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0d7377;" />
      </children>
      <padding><Insets top="20" bottom="20" /></padding>
      <VBox.margin><Insets left="20" right="20" top="20" /></VBox.margin>
    </VBox>

    <!-- Logout button -->
    <Button text="Log Out" onAction="#handleLogout"
            maxWidth="1.7976931348623157E308"
            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px;
            -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14 0 14 0; -fx-cursor: hand;">
      <VBox.margin><Insets left="20" right="20" top="30" /></VBox.margin>
    </Button>
  </children>
</VBox>
