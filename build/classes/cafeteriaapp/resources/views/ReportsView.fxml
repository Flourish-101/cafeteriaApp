<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="904.0" style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.OrderHistoryController">
  <top>
    <VBox style="-fx-background-color: #f8f9fa;">
      <children>
        <Label text="My Orders" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0d7377;">
          <VBox.margin><Insets left="20.0" top="20.0" bottom="10.0" /></VBox.margin>
        </Label>
      </children>
    </VBox>
  </top>
  <center>
    <VBox>
      <children>
        <ScrollPane fitToWidth="true" prefHeight="500.0" styleClass="scroll-pane">
          <content>
            <VBox fx:id="ordersContainer" prefWidth="864.0">
              <padding><Insets left="20.0" right="20.0" top="10.0" bottom="20.0" /></padding>
            </VBox>
          </content>
        </ScrollPane>
        <Label fx:id="emptyLabel" text="No orders yet. Start ordering from the menu! 🍽️"
               style="-fx-font-size: 14px; -fx-text-fill: #888; -fx-alignment: CENTER;"
               maxWidth="1.7976931348623157E308" visible="false">
          <VBox.margin><Insets top="40.0" /></VBox.margin>
        </Label>
      </children>
    </VBox>
  </center>
</BorderPane>
