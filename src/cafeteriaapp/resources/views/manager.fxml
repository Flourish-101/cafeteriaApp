<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.ManagerController">
  <top>
    <HBox prefHeight="60.0" prefWidth="1050.0" alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: #0d7377;">
      <children>
        <Label text="☕ PAU Cafeteria — Manager Dashboard" textFill="WHITE"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
        <Button text="Logout" onAction="#handleLogout"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;
                -fx-padding: 8 20 8 20; -fx-cursor: hand; -fx-font-weight: bold;" />
      </children>
      <padding><Insets left="20.0" right="20.0" /></padding>
    </HBox>
  </top>
  <center>
    <HBox spacing="20" prefWidth="1050.0">
      <children>
        <!-- Left: Table -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
          <children>
            <Label text="Menu Items" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0d7377;" />
            <TableView fx:id="menuTable" prefHeight="580.0">
              <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40" />
                <TableColumn fx:id="colName" text="Name" prefWidth="180" />
                <TableColumn fx:id="colCategory" text="Category" prefWidth="100" />
                <TableColumn fx:id="colQty" text="Qty" prefWidth="60" />
                <TableColumn fx:id="colPrice" text="Price (₦)" prefWidth="90" />
                <TableColumn fx:id="colDesc" text="Description" prefWidth="200" />
              </columns>
            </TableView>
            <HBox spacing="10">
              <children>
                <Button text="🗑 Delete Selected" onAction="#handleDelete"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;
                        -fx-padding: 9 18 9 18; -fx-cursor: hand; -fx-font-weight: bold;" />
              </children>
            </HBox>
          </children>
          <padding><Insets top="20" left="20" bottom="20" /></padding>
        </VBox>

        <!-- Right: Form -->
        <VBox prefWidth="280.0" spacing="12"
              style="-fx-background-color: white; -fx-background-radius: 12;
              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
          <children>
            <Label text="Add / Edit Item" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0d7377;" />
            <Separator />

            <Label text="Item Name" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" />
            <TextField fx:id="nameField" promptText="e.g. Jollof Rice"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;
                       -fx-padding: 8 12 8 12;" />

            <Label text="Category" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" />
            <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;" />

            <Label text="Price (₦)" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" />
            <TextField fx:id="priceField" promptText="e.g. 1500.00"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;
                       -fx-padding: 8 12 8 12;" />

            <Label text="Quantity in Stock" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" />
            <TextField fx:id="qtyField" promptText="e.g. 50"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;
                       -fx-padding: 8 12 8 12;" />

            <Label text="Description" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" />
            <TextArea fx:id="descField" promptText="Short description..." prefRowCount="3" wrapText="true"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;
                      -fx-padding: 8 12 8 12;" />

            <Button fx:id="saveBtn" text="Add Item" onAction="#handleSave" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #0d7377; -fx-text-fill: white; -fx-font-weight: bold;
                    -fx-background-radius: 8; -fx-padding: 11 0 11 0; -fx-cursor: hand; -fx-font-size: 14px;" />
            <Button fx:id="clearBtn" text="Clear Form" onAction="#clearForm" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 8;
                    -fx-background-radius: 8; -fx-padding: 9 0 9 0; -fx-cursor: hand;" />
          </children>
          <padding><Insets top="20" left="20" right="20" bottom="20" /></padding>
        </VBox>
      </children>
      <padding><Insets top="0" right="20" bottom="0" /></padding>
    </HBox>
  </center>
</BorderPane>
