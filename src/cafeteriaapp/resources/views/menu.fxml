<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="639.0" prefWidth="835.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.MenuController">
   <top>
      <VBox prefHeight="126.0" prefWidth="835.0" style="-fx-background-color: #0d7377;"
            BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="835.0" spacing="12.0">
               <children>
                  <FontAwesomeIconView fill="WHITE" glyphName="ARROW_LEFT" size="18.0"
                                       onMouseClicked="#goBack" style="-fx-cursor: hand;" />
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="35.0"
                         text="Menu" textFill="WHITE" HBox.hgrow="ALWAYS">
                     <font><Font size="24.0" /></font>
                  </Label>
                  <StackPane onMouseClicked="#goToCart" style="-fx-cursor: hand;">
                     <children>
                        <FontAwesomeIconView fill="WHITE" glyphName="SHOPPING_CART" size="22.0" />
                        <Label fx:id="cartCountLabel"
                               style="-fx-background-color: white; -fx-text-fill: #0d7377;
                                      -fx-background-radius: 10; -fx-font-size: 10px;
                                      -fx-font-weight: bold; -fx-padding: 1 4 1 4;"
                               StackPane.alignment="TOP_RIGHT" visible="false" />
                     </children>
                  </StackPane>
               </children>
               <padding><Insets left="20.0" right="20.0" /></padding>
            </HBox>
            <StackPane prefHeight="67.0" prefWidth="835.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="37.0" prefWidth="835.0"
                             promptText="Search menu items..." />
                  <FontAwesomeIconView glyphName="SEARCH" StackPane.alignment="CENTER_LEFT">
                     <StackPane.margin><Insets left="20.0" /></StackPane.margin>
                  </FontAwesomeIconView>
               </children>
               <padding><Insets left="50.0" right="50.0" /></padding>
            </StackPane>

            <!-- Category filter tabs -->
            <ScrollPane fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER" prefHeight="46.0"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
               <content>
                  <HBox fx:id="categoryTabsBox" spacing="8" alignment="CENTER_LEFT">
                     <padding><Insets left="20.0" right="20.0" top="6.0" bottom="6.0" /></padding>
                  </HBox>
               </content>
            </ScrollPane>
         </children>
         <padding><Insets top="10.0" /></padding>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
         <content>
            <VBox fx:id="menuListContainer" prefHeight="200.0" prefWidth="100.0">
               <padding><Insets right="20.0" /></padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
